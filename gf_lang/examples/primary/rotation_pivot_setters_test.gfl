lang_v 0.0.4
$stripe_color #39b812
$ring_color #ff8000
$ring_2_color #004cff
color-background = rgb(0.9 0.9 0.9)
material = shader(gf_shader_test) |
    {color = $stripe_color | material_prop = gf_shader_test(shader_uniform cr($cr)) | material_prop = gf_shader_test(shader_uniform cg($cg)) | material_prop = gf_shader_test(shader_uniform cb($cb))}
x=-15 z=-5 stripe
rule stripe max=5:
    if $i == 3:
        stripe_2
    y=2 cube
    stripe
rule stripe_2 max=10:
    if $i == 5:
        color = $ring_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
        push rotation_pivot current_pos
        line = start()
        y 1.5
        ring
        y -1.5
        pop rotation_pivot current_pos
        color = $stripe_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
    if $i == 7:
        color = $ring_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
        push rotation_pivot current_pos
        line = start()
        y 3
        ring
        y -3
        pop rotation_pivot current_pos
        color = $stripe_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
    if $i == 8:
        color = $ring_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
        push rotation_pivot current_pos
        line = start()
        y 5
        ring
        y -5
        pop rotation_pivot current_pos
        color = $stripe_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
    if $i == 9:
        color = $ring_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
        push rotation_pivot current_pos
        line = start()
        y 8
        ring
        y -8
        pop rotation_pivot current_pos
        color = $stripe_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
    x=3 cube
    stripe_2
rule ring max=25:
    if $i == 6:
        color = $ring_2_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
        push rotation_pivot current_pos
        ring_2
        line
        pop rotation_pivot current_pos
        color = $ring_color |
            material_prop = gf_shader_test(shader_uniform cr($cr)) |
            material_prop = gf_shader_test(shader_uniform cg($cg)) |
            material_prop = gf_shader_test(shader_uniform cb($cb))
    scale = (0.3 0.3 0.3)
    rx=0.25 cube
    line
    ring
rule ring_2 max=50:
    scale = (0.2 0.2 0.2)
    ry=0.25 cube
    line
    ring_2
shader gf_shader_test:
    uniform cr float 0.5
    uniform cg float 0.5
    uniform cb float 0.5
    vertex """
        varying vec3 normal_f;
        varying vec3 local_pos_v3;
        void main() {
        normal_f     = normalize(normalMatrix * normal);
        local_pos_v3 = position;
        vec4 pos     = modelViewMatrix * vec4(position, 1.0);
        gl_Position  = projectionMatrix * pos;
        }
    """
    fragment """
        precision highp float;
        uniform float i;
        uniform float cr;
        uniform float cg;
        uniform float cb;
        varying vec3 normal_f;
        varying vec3 local_pos_v3;
        void main() {
        vec3 light_direction_v3 = vec3(0.8, 1, 0.8);
        vec3 color_v3           = vec3(cr, cg, cb);
        float diffuse_f = .5 + dot(normal_f, light_direction_v3);
        gl_FragColor    = vec4(diffuse_f * color_v3, 1.0);
        }
    """
