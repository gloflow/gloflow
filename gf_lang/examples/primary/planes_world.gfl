    {scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane}
color = $feather_color_3 |
    material = wireframe(true) |
    y=10.6 x=3 rz=0.6 |
    {scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
