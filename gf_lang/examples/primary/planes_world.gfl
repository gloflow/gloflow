lang_v 0.0.3
$feather_color_1 #e2b31d
$feather_color_3 #761f25
$feather_color_9 #ac8c7c
color-background = rgb(0.9 0.9 0.9)
iters_max = 500000
color = #42b0f5 |
    material = wireframe(true) |
    {scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane} |
    {z=2 | scale = (0.1 5 1) | feather_plane}
