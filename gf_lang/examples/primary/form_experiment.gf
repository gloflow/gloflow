    ["rule", "small_block_base", [["iters_max", 200]], [[["x", 0.5, "y", -0.6, "sx", -0.005, "sy", -0.005, "sz", -0.005, "cr", 0.005, "cg", 0.005, "cb", 0.005], "cube"], ["small_block_base"]]],
    ["rule", "small_block_base", [["iters_max", 200]], [[["x", 0.5, "y", -0.6, "z", 0.6, "sx", -0.005, "sy", -0.005, "sz", -0.005, "cr", 0.005, "cg", 0.005, "cb", 0.005], "cube"], ["small_block_base"]]],
    ["rule", "small_block_base", [["iters_max", 200]], [[["x", 0.5, "y", 0.6, "z", -0.6, "sx", -0.005, "sy", -0.005, "sz", -0.005, "cr", 0.005, "cg", 0.005, "cb", 0.005], "cube"], ["small_block_base"]]],
    ["rule", "mothership_module", [["iters_max", 3]], [[["y", 6, "sx", -10, "sy", -10, "sz", -10], "cube"], ["mothership_module"]]],
    ["rule", "mothership_module_connection", [["iters_max", 100000]], [["set", "scale", [4, 4, 4]], ["if", ["==", "$i", 14], [[["z", -10], "mothership_module_connection_uncle"], ["uncle_tangent__z_positive"], ["z", 10]]], ["if", ["==", "$i", 20], [[["z", 15], "mothership_module_connection_uncle"], ["uncle_tangent__z_negative"], ["z", -15]]], ["if", ["==", "$i", 10], [[["x", 10], "mothership_module_connection_uncle"], ["uncle_tangent__z_positive"], ["x", -10]]], [["y", 7], "cube"], ["mothership_module_connection"]]],
    ["rule", "mothership_module_connection_uncle", [["iters_max", 60]], [["set", "scale", [2, 2, 2]], ["set", "color", "$connection_uncle_color"], [["y", 7], "cube"], ["mothership_module_connection_uncle"]]],
    ["rule", "uncle_tangent__z_positive", [["iters_max", 6000]], [[["z", 4], "cube"], "uncle_tangent__z_positive"]],
    ["rule", "uncle_tangent__z_negative", [["iters_max", 6000]], [[["z", -4], "cube"], "uncle_tangent__z_negative"]],
    ["rule", "mothership_module_movement", [["iters_max", 1]], [[["set", "color", "$main_block_color"], ["set", "scale", [10, 10, 10]], "cube"], ["x", 5.45], [["set", "color", "$small_block_2_color"], ["set", "scale", [1, 1, 1]], [["y", 3], "cube"], ["small_block_base"]], [["set", "color", "$small_block_color"], ["set", "scale", [1, 1, 1]], [["y", -5, "z", 2], "cube"], ["small_block_base"]], [["set", "color", "$small_block_color"], ["set", "scale", [1, 1, 1]], [["y", -1, "z", -2.2], "cube"], ["small_block_base"]], [["set", "color", "$small_block_color"], ["set", "scale", [1, 1, 1]], [["y", 3, "z", -1], "cube"], ["small_block_base"]], [["set", "color", "$small_block_2_color"], ["set", "scale", [1, 1, 1]], [["y", -3.5, "z", 3], "cube"], ["small_block_base"]]]]
