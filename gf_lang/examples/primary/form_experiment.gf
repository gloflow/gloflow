    ["$small_block_2_color", "#29405E"],
    ["set", "color-background", ["rgb", 0.7, 0.7, 0.7]],
    [["set", "material", ["wireframe", true]], ["set", "color", "$mothership_color"], ["set", "scale", [100, 100, 100]], ["x", -55, "cube"], ["set", "scale", [80, 80, 80]], ["set", "color", "$mothership_module_color"], [["y", 12], "mothership_module"], ["set", "material", ["wireframe", true]], ["mothership_module_connection"]],
    [["set", "color", "$mothership_2_color"], ["set", "scale", [30, 30, 30]], ["set", "material", ["wireframe", true]], ["x", -15, "cube"]],
    ["mothership_module_movement"],
