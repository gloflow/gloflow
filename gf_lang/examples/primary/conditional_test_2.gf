[
    ["lang_v", "0.0.3"],
    ["$main_branches_color_1", "#334ea2"],
    ["$main_branches_color_2", "#4b69c6"],
    ["$main_branches_color_3", "#6881cf"],
    ["$secondary_branches_color_1", "#118984"],
    ["$secondary_branches_color_2", "#79bd5e"],
