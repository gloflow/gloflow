lang_v 0.0.3
$mothership_color #EB4B0F
$mothership_module_color #DC470F
$mothership_2_color #E1761F
$connection_uncle_color #F28D68
$main_block_color #4176B6
$small_block_color #355C8E
$small_block_2_color #29405E
color-background = rgb(0.7 0.7 0.7)
material = wireframe(true) |
    color = $mothership_color |
    scale = (100 100 100) |
    x -55 cube |
    scale = (80 80 80) |
    color = $mothership_module_color |
    {y=12 mothership_module} |
    material = wireframe(true) |
    mothership_module_connection()
color = $mothership_2_color | scale = (30 30 30) | material = wireframe(true) | x -15 cube
mothership_module_movement
rule small_block_base max=200:
    x=0.5 y=0.6 sx=-0.005 sy=-0.005 sz=-0.005 cr=0.005 cg=0.005 cb=0.005 cube
    small_block_base
rule small_block_base max=200:
    x=0.5 y=-0.6 sx=-0.005 sy=-0.005 sz=-0.005 cr=0.005 cg=0.005 cb=0.005 cube
    small_block_base
rule small_block_base max=200:
    x=0.5 y=-0.6 z=0.6 sx=-0.005 sy=-0.005 sz=-0.005 cr=0.005 cg=0.005 cb=0.005 cube
    small_block_base
rule small_block_base max=200:
    x=0.5 y=0.6 z=-0.6 sx=-0.005 sy=-0.005 sz=-0.005 cr=0.005 cg=0.005 cb=0.005 cube
    small_block_base
rule mothership_module max=3:
    y=6 sx=-10 sy=-10 sz=-10 cube
    mothership_module
rule mothership_module_connection max=100000:
    scale = (4 4 4)
    if $i == 14:
        z=-10 mothership_module_connection_uncle
        uncle_tangent__z_positive
        z 10
    if $i == 20:
        z=15 mothership_module_connection_uncle
        uncle_tangent__z_negative
        z -15
    if $i == 10:
        x=10 mothership_module_connection_uncle
        uncle_tangent__z_positive
        x -10
    y=7 cube
    mothership_module_connection
rule mothership_module_connection_uncle max=60:
    scale = (2 2 2)
    color = $connection_uncle_color
    y=7 cube
    mothership_module_connection_uncle
rule uncle_tangent__z_positive max=6000:
    z=4 cube
    "uncle_tangent__z_positive"
rule uncle_tangent__z_negative max=6000:
    z=-4 cube
    "uncle_tangent__z_negative"
rule mothership_module_movement max=1:
    color = $main_block_color | scale = (10 10 10) | cube
    x 5.45
    color = $small_block_2_color | scale = (1 1 1) | {y=3 cube} | small_block_base()
    color = $small_block_color | scale = (1 1 1) | {y=-5 z=2 cube} | small_block_base()
    color = $small_block_color | scale = (1 1 1) | {y=-1 z=-2.2 cube} | small_block_base()
    color = $small_block_color | scale = (1 1 1) | {y=3 z=-1 cube} | small_block_base()
    color = $small_block_2_color | scale = (1 1 1) | {y=-3.5 z=3 cube} | small_block_base()
