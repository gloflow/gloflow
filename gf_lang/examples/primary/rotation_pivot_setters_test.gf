[
    ["lang_v", "0.0.4"],
    ["$stripe_color", "#39b812"],
    ["$ring_color", "#ff8000"],
    ["$ring_2_color", "#004cff"],
    ["set", "color-background", ["rgb", 0.9, 0.9, 0.9]],
    [["set", "material", ["shader", "gf_shader_test"]], [["set", "color", "$stripe_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]],
    [["x", -15, "z", -5], "stripe"],
    ["rule", "stripe", [["iters_max", 5]], [["if", ["==", "$i", 3], [["stripe_2"]]], [["y", 2], "cube"], ["stripe"]]],
    ["rule", "stripe_2", [["iters_max", 10]], [["if", ["==", "$i", 5], [[["set", "color", "$ring_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]], ["push", "rotation_pivot", "current_pos"], ["set", "line", ["start"]], ["y", 1.5], ["ring"], ["y", -1.5], ["pop", "rotation_pivot", "current_pos"], [["set", "color", "$stripe_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]]], ["if", ["==", "$i", 7], [[["set", "color", "$ring_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]], ["push", "rotation_pivot", "current_pos"], ["set", "line", ["start"]], ["y", 3], ["ring"], ["y", -3], ["pop", "rotation_pivot", "current_pos"], [["set", "color", "$stripe_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]]], ["if", ["==", "$i", 8], [[["set", "color", "$ring_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]], ["push", "rotation_pivot", "current_pos"], ["set", "line", ["start"]], ["y", 5], ["ring"], ["y", -5], ["pop", "rotation_pivot", "current_pos"], [["set", "color", "$stripe_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]]], ["if", ["==", "$i", 9], [[["set", "color", "$ring_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]], ["push", "rotation_pivot", "current_pos"], ["set", "line", ["start"]], ["y", 8], ["ring"], ["y", -8], ["pop", "rotation_pivot", "current_pos"], [["set", "color", "$stripe_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]]], [["x", 3], "cube"], ["stripe_2"]]],
    ["rule", "ring", [["iters_max", 25]], [["if", ["==", "$i", 6], [[["set", "color", "$ring_2_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]], ["push", "rotation_pivot", "current_pos"], ["ring_2"], ["line"], ["pop", "rotation_pivot", "current_pos"], [["set", "color", "$ring_color"], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cr", "$cr"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cg", "$cg"]]], ["set", "material_prop", ["gf_shader_test", "shader_uniform", ["cb", "$cb"]]]]]], ["set", "scale", [0.3, 0.3, 0.3]], [["rx", 0.25], "cube"], ["line"], ["ring"]]],
    ["rule", "ring_2", [["iters_max", 50]], [["set", "scale", [0.2, 0.2, 0.2]], [["ry", 0.25], "cube"], ["line"], ["ring_2"]]],
    ["shader", "gf_shader_test", ["uniforms", [["cr", "float", 0.5], ["cg", "float", 0.5], ["cb", "float", 0.5]]], ["vertex", "varying vec3 normal_f;\nvarying vec3 local_pos_v3;\nvoid main() {\nnormal_f     = normalize(normalMatrix * normal);\nlocal_pos_v3 = position;\nvec4 pos     = modelViewMatrix * vec4(position, 1.0);\ngl_Position  = projectionMatrix * pos;\n}"], ["fragment", "precision highp float;\nuniform float i;\nuniform float cr;\nuniform float cg;\nuniform float cb;\nvarying vec3 normal_f;\nvarying vec3 local_pos_v3;\nvoid main() {\nvec3 light_direction_v3 = vec3(0.8, 1, 0.8);\nvec3 color_v3           = vec3(cr, cg, cb);\nfloat diffuse_f = .5 + dot(normal_f, light_direction_v3);\ngl_FragColor    = vec4(diffuse_f * color_v3, 1.0);\n}"]]
]
