lang_v 0.0.4
color-background = rgb(0.9 0.9 0.9)
color = rgb(0.2 0.2 0.2) |
    material = shader(gf_shader_test) |
    material_prop = gf_shader_test(shader_uniform i(0.8)) |
    material_prop = gf_shader_test(shader_uniform cr($cr)) |
    material_prop = gf_shader_test(shader_uniform cg($cg)) |
    material_prop = gf_shader_test(shader_uniform cb($cb)) |
    x=0 y=20 z=2 |
    * 20 x(1.3 stripe)
rule stripe max=50:
    if $i == 0:
        line = start()
    y=-1.3 | z=0.1 | sx=(-0.001 * $i) sy=(-0.005 * $i) sz=(-0.001 * $i) cube
    line
    stripe
rule stripe max=50:
    if $i == 0:
        line = start()
    y=-1.3 |
        z=-0.1 |
        sx=(-0.001 * $i) sy=(-0.001 * $i) sz=(-0.001 * $i) |
        {cr=0.01 cg=0.01 cb=0.01 | material_prop = gf_shader_test(shader_uniform cr($cr)) | material_prop = gf_shader_test(shader_uniform cg($cg)) | material_prop = gf_shader_test(shader_uniform cb($cb))} |
        cube
    line
    stripe
rule stripe max=50:
    if $i == 0:
        line = start()
    y=-2.3 |
        z=0.1 |
        sx=(-0.001 * $i) sy=(-0.001 * $i) sz=(-0.001 * $i) |
        color = rgb(0.1 0.1 0.1) |
        if(($i > 40) branch()) |
        cube
    line
    stripe
rule branch max=20:
    scale = (0.1 0.1 0.1)
    color = rgb(0.7 0.7 0.7) |
        material_prop = gf_shader_test(shader_uniform cr($cr)) |
        material_prop = gf_shader_test(shader_uniform cg($cg)) |
        material_prop = gf_shader_test(shader_uniform cb($cb))
    z=0.2 cube
    if $i > rand((15 17)):
        z 0.5
        material = wireframe(true)
        crown
        material = wireframe(false)
        material_prop = gf_shader_test(shader_uniform cr($cr))
        material_prop = gf_shader_test(shader_uniform cg($cg))
        material_prop = gf_shader_test(shader_uniform cb($cb))
    if $i == 19:
        "crown_top"
    "branch"
rule crown max=1:
    scale = {rand (0.3 0.9) | rand (0.3 0.9) | rand (0.3 0.9)}
    color = #ff5512 |
        material_prop = gf_shader_test(shader_uniform cr($cr)) |
        material_prop = gf_shader_test(shader_uniform cg($cg)) |
        material_prop = gf_shader_test(shader_uniform cb($cb)) |
        cube
    "crown"
rule crown max=1:
    scale = {rand (0.3 0.9) | rand (0.3 0.9) | rand (0.3 0.9)}
    color = #ff8c00 |
        material_prop = gf_shader_test(shader_uniform cr($cr)) |
        material_prop = gf_shader_test(shader_uniform cg($cg)) |
        material_prop = gf_shader_test(shader_uniform cb($cb)) |
        cube
    "crown"
rule crown_top max=20:
    if $i == 0:
        line = start()
    scale = (0.05 0.05 0.05)
    color = rgb(0.7 0.7 0.7) |
        material_prop = gf_shader_test(shader_uniform cr($cr)) |
        material_prop = gf_shader_test(shader_uniform cg($cg)) |
        material_prop = gf_shader_test(shader_uniform cb($cb))
    z=0.2 cube
    line
    "crown_top"
shader gf_shader_test:
    uniform i float 0.1
    uniform cr float 0.5
    uniform cg float 0.5
    uniform cb float 0.5
    vertex """
        varying vec3 normal_f;
        varying vec3 local_pos_v3;
        void main() {
        normal_f     = normalize(normalMatrix * normal);
        local_pos_v3 = position;
        vec4 pos     = modelViewMatrix * vec4(position, 1.0);
        gl_Position  = projectionMatrix * pos;
        }
    """
    fragment """
        precision highp float;
        uniform float i;
        uniform float cr;
        uniform float cg;
        uniform float cb;
        varying vec3 normal_f;
        varying vec3 local_pos_v3;
        void main() {
        vec3 light_direction_v3 = vec3(0.0, 1, 1.0);
        vec3 color_v3           = vec3(cr, cg, cb);
        float diffuse_f = .5 + dot(normal_f, light_direction_v3);
        gl_FragColor    = vec4(diffuse_f * color_v3, 1.0);
        }
    """
