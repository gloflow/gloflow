lang_v 0.0.3
color-background = rgb(0.7 0.7 0.7)
color = rgb(0.7 0 0) | material = wireframe(true) | iters_max = 30 | R1()
rule R1 max=10:
    print ("first condition" $i)
    if $i == 2:
        print ($i "running R2 A")
        R2
    print ("second condition" $i)
    if $i == 4:
        print ($i "running R2 B")
        R2
    print ("third condition" $i)
    if $i == 8:
        print ($i "running R2 C")
        R2
    color = rgb(0.7 0 0)
    repeat 1:
        x=2 cube
    R1
rule R2 max=5:
    print ("===============in R2" $i)
    y 4
    print ("first R2 condition" $i)
    if $i > 2:
        color = rgb(0 0.9 0)
        print ($i "running R3")
        R3
    print ("===============in R2 cube" $i) |
        color = rgb(0 0 0.9) |
        * 1 cube() |
        print ("===============exit R2" $i) |
        R2()
rule R3 max=5:
    print ($i "===============in R3")
    repeat 1:
        z=4 cube
    print ($i "===============exit R3")
    "R3"
